# Cloudflare Workers Static Assets headers. Applied to files served from dist/browser.
# The CSP allows Cloudflare Web Analytics, which Cloudflare injects into the pages.
# Private, client-rendered routes are answered by cloudflare/worker.mjs, which adds X-Robots-Tag itself.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(self), microphone=(), geolocation=(), payment=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Frame-Options: DENY
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob:; connect-src 'self' https://*.r2.cloudflarestorage.com https://cloudflareinsights.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self'

# Hashed bundles never change: cache for a year.
/*.js
  Cache-Control: public, max-age=31536000, immutable
/*.css
  Cache-Control: public, max-age=31536000, immutable

# Prerendered pages and the app shell change with every deploy: revalidate.
/*.html
  Cache-Control: public, max-age=0, must-revalidate
/
  Cache-Control: public, max-age=0, must-revalidate
